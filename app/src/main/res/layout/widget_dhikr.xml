<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/dh_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent">

    <ImageView
        android:id="@+id/dh_bg"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:src="@drawable/widget_opt_square_bg" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:layout_alignLeft="@id/dh_bg"
        android:layout_alignTop="@id/dh_bg"
        android:layout_alignRight="@id/dh_bg"
        android:layout_alignBottom="@id/dh_bg"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="10dp">

        <TextView android:fontFamily="@font/outfit_regular"
            android:id="@+id/dh_label"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textColor="#B3FFFFFF"
            android:textSize="11sp" />

        <TextView android:fontFamily="@font/outfit_bold"
            android:id="@+id/dh_count"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView android:fontFamily="@font/outfit_bold"
            android:id="@+id/dh_reset"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:paddingLeft="14dp"
            android:paddingTop="4dp"
            android:paddingRight="14dp"
            android:paddingBottom="4dp"
            android:gravity="center"
            android:includeFontPadding="false"
            android:singleLine="true"
            android:text="@string/zikir_reset"
            android:textColor="#FFFFFF"
            android:textSize="11sp"
            android:textStyle="bold"
            android:visibility="gone" />
    </LinearLayout>
</RelativeLayout>
